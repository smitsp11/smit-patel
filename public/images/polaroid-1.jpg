<svg xmlns="http://www.w3.org/2000/svg" width="400" height="400" viewBox="0 0 400 400">
  <defs>
    <linearGradient id="bg1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#2d3436;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1a1a2e;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="400" height="400" fill="url(#bg1)"/>
  <!-- Monitor -->
  <rect x="100" y="120" width="200" height="140" rx="8" fill="#3d2914" stroke="#c9a55c" stroke-width="2"/>
  <rect x="110" y="130" width="180" height="110" fill="#0d1117"/>
  <!-- Code lines -->
  <rect x="120" y="145" width="60" height="8" rx="2" fill="#d4a574"/>
  <rect x="190" y="145" width="40" height="8" rx="2" fill="#b87333"/>
  <rect x="120" y="160" width="40" height="8" rx="2" fill="#7f8c8d"/>
  <rect x="170" y="160" width="80" height="8" rx="2" fill="#d4a574"/>
  <rect x="120" y="175" width="90" height="8" rx="2" fill="#b87333"/>
  <rect x="130" y="190" width="50" height="8" rx="2" fill="#7f8c8d"/>
  <rect x="190" y="190" width="60" height="8" rx="2" fill="#d4a574"/>
  <rect x="120" y="205" width="70" height="8" rx="2" fill="#b87333"/>
  <!-- Stand -->
  <rect x="180" y="260" width="40" height="20" fill="#3d2914"/>
  <rect x="160" y="280" width="80" height="10" rx="2" fill="#3d2914"/>
  <!-- Keyboard -->
  <rect x="110" y="310" width="180" height="40" rx="4" fill="#3d2914" stroke="#c9a55c" stroke-width="1"/>
  <rect x="120" y="320" width="160" height="6" rx="2" fill="#1a1a2e"/>
  <rect x="120" y="332" width="160" height="6" rx="2" fill="#1a1a2e"/>
</svg>